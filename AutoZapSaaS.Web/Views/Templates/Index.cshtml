@model TemplatesViewModel
@{ ViewData["Title"] = "Mensagens automáticas"; }

<h1>Mensagens automáticas</h1>
<p class="subtitulo">O texto enviado ao cliente quando acontece um evento na sua loja.</p>

<div class="cartao">
    <h2>Nova mensagem</h2>
    <form method="post" asp-controller="Templates" asp-action="Criar">
        <div class="grade grade-2">
            <div class="campo">
                <label for="nome">Nome</label>
                <input id="nome" name="nome" placeholder="Ex.: Confirmação de pedido" />
            </div>

            <div class="campo">
                <label for="evento">Quando enviar</label>
                <select id="evento" name="evento">
                    @foreach (var e in TemplatesViewModel.Eventos)
                    {
                        <option value="@e.Valor">@e.Rotulo</option>
                    }
                </select>
            </div>
        </div>

        <div class="campo">
            <label for="corpo">Texto da mensagem</label>
            <textarea id="corpo" name="corpo" placeholder="Olá {{nome}}! Recebemos seu pedido. {{detalhe}}"></textarea>
            <p class="dica">
                Use <strong>{{nome}}</strong> para o nome do cliente e
                <strong>{{detalhe}}</strong> para os dados do pedido.
            </p>
        </div>

        <button type="submit" class="botao">Criar mensagem</button>
    </form>
</div>

<div class="cartao">
    <h2>Suas mensagens</h2>

    @if (!Model.Templates.Any())
    {
        <div class="vazio">
            <p>Nenhuma mensagem automática criada.</p>
            <p class="dica">Sem pelo menos uma, o AutoZap envia um texto padrão genérico.</p>
        </div>
    }
    else
    {
        <div class="rolagem">
            <table class="tabela">
                <thead>
                <tr>
                    <th>Nome</th>
                    <th>Quando</th>
                    <th>Texto</th>
                    <th>Situação</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var t in Model.Templates)
                {
                    <tr>
                        <td><strong>@t.Name</strong></td>
                        <td>@TemplatesViewModel.RotuloDoEvento(t.EventType)</td>
                        <td style="max-width:340px; color:var(--suave)">@t.Body</td>
                        <td>
                            <span class="selo @(t.IsActive ? "selo-ok" : "selo-neutro")">
                                @(t.IsActive ? "Ativa" : "Inativa")
                            </span>
                        </td>
                        <td>
                            <form method="post" asp-controller="Templates" asp-action="Remover"
                                  onsubmit="return confirm('Remover esta mensagem automática?');">
                                <input type="hidden" name="id" value="@t.Id" />
                                <button type="submit" class="botao botao-perigo botao-pequeno">Remover</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
