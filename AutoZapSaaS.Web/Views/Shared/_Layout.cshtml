@{
    var autenticado = User.Identity?.IsAuthenticated == true;
    var atual = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Ativo(string controller) =>
        atual.Equals(controller, StringComparison.OrdinalIgnoreCase) ? "ativo" : "";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · AutoZap</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(autenticado ? "" : "tela-limpa")">

@if (autenticado)
{
    <aside class="barra-lateral">
        <div class="marca">
            <span class="marca-icone">⚡</span>
            <span class="marca-nome">AutoZap</span>
        </div>

        <nav>
            <a class="@Ativo("Painel")" asp-controller="Painel" asp-action="Index">Painel</a>
            <a class="@Ativo("Instancias")" asp-controller="Instancias" asp-action="Index">WhatsApp</a>
            <a class="@Ativo("Templates")" asp-controller="Templates" asp-action="Index">Mensagens automáticas</a>
            <a class="@Ativo("Clientes")" asp-controller="Clientes" asp-action="Index">Clientes</a>
            <a class="@Ativo("Historico")" asp-controller="Historico" asp-action="Index">Histórico</a>
            <a class="@Ativo("Webhooks")" asp-controller="Webhooks" asp-action="Index">Integrações</a>
            <a class="@Ativo("Planos")" asp-controller="Planos" asp-action="Index">Plano</a>
        </nav>

        <form method="post" asp-controller="Conta" asp-action="Sair" class="rodape-lateral">
            <div class="usuario" title="@User.Identity!.Name">@User.Identity!.Name</div>
            <button type="submit" class="botao-texto">Sair</button>
        </form>
    </aside>

    <main class="conteudo">
        @await Html.PartialAsync("_Avisos")
        @RenderBody()
    </main>
}
else
{
    <main class="centralizado">
        @RenderBody()
    </main>
}

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
