@model LoginViewModel
@{ ViewData["Title"] = "Entrar"; }

<div class="caixa-login">
    <div class="marca">
        <span class="marca-icone">⚡</span>
        <span class="marca-nome">AutoZap</span>
    </div>

    <div class="cartao">
        <h2>Entrar na sua conta</h2>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="aviso aviso-erro">
                @ViewData.ModelState[string.Empty]!.Errors.First().ErrorMessage
            </div>
        }

        <form method="post" asp-controller="Conta" asp-action="Login">
            <div class="campo">
                <label asp-for="Email">E-mail</label>
                <input asp-for="Email" type="email" autocomplete="username" autofocus />
                <span asp-validation-for="Email" class="dica"></span>
            </div>

            <div class="campo">
                <label asp-for="Senha">Senha</label>
                <input asp-for="Senha" type="password" autocomplete="current-password" />
                <span asp-validation-for="Senha" class="dica"></span>
            </div>

            <button type="submit" class="botao botao-largo">Entrar</button>
        </form>
    </div>

    <div class="rodape-form">
        Ainda não tem conta?
        <a asp-controller="Conta" asp-action="Cadastro">Criar conta grátis</a>
    </div>
</div>
