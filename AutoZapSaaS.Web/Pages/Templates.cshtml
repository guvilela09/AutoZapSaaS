@page
@model AutoZapSaaS.Web.Pages.TemplatesModel
@{ ViewData["Title"] = "Mensagens automáticas"; }

<h1>Mensagens automáticas</h1>
<p class="subtitulo">O texto enviado ao cliente quando acontece um evento na sua loja.</p>

@if (!string.IsNullOrEmpty(Model.Erro))
{
    <div class="aviso aviso-erro">@Model.Erro</div>
}
@if (!string.IsNullOrEmpty(Model.Sucesso))
{
    <div class="aviso aviso-ok">@Model.Sucesso</div>
}

<div class="cartao">
    <h2>Nova mensagem</h2>
    <form method="post" asp-page-handler="Criar">
        <div class="grade grade-2">
            <div class="campo">
                <label asp-for="Nome">Nome</label>
                <input asp-for="Nome" placeholder="Ex.: Confirmação de pedido" />
            </div>

            <div class="campo">
                <label asp-for="Evento">Quando enviar</label>
                <select asp-for="Evento">
                    @foreach (var e in AutoZapSaaS.Web.Pages.TemplatesModel.Eventos)
                    {
                        <option value="@e.Valor">@e.Rotulo</option>
                    }
                </select>
            </div>
        </div>

        <div class="campo">
            <label asp-for="Corpo">Texto da mensagem</label>
            <textarea asp-for="Corpo" placeholder="Olá {{nome}}! Recebemos seu pedido. {{detalhe}}"></textarea>
            <p class="dica">
                Use <strong>{{nome}}</strong> para o nome do cliente e
                <strong>{{detalhe}}</strong> para os dados do pedido.
            </p>
        </div>

        <button type="submit" class="botao">Criar mensagem</button>
    </form>
</div>

<div class="cartao">
    <h2>Suas mensagens</h2>

    @if (!Model.Templates.Any())
    {
        <div class="vazio">
            <p>Nenhuma mensagem automática criada.</p>
            <p class="dica">Sem pelo menos uma, o AutoZap envia um texto padrão genérico.</p>
        </div>
    }
    else
    {
        <div class="rolagem">
            <table class="tabela">
                <thead>
                <tr>
                    <th>Nome</th>
                    <th>Quando</th>
                    <th>Texto</th>
                    <th>Situação</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var t in Model.Templates)
                {
                    <tr>
                        <td><strong>@t.Name</strong></td>
                        <td>@AutoZapSaaS.Web.Pages.TemplatesModel.RotuloDoEvento(t.EventType)</td>
                        <td style="max-width:340px; color:var(--suave)">@t.Body</td>
                        <td>
                            <span class="selo @(t.IsActive ? "selo-ok" : "selo-neutro")">
                                @(t.IsActive ? "Ativa" : "Inativa")
                            </span>
                        </td>
                        <td>
                            <form method="post" asp-page-handler="Remover" asp-route-id="@t.Id"
                                  onsubmit="return confirm('Remover esta mensagem automática?');">
                                <button type="submit" class="botao botao-perigo botao-pequeno">Remover</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
