@page
@model AutoZapSaaS.Web.Pages.InstanciasModel
@{ ViewData["Title"] = "WhatsApp"; }

<h1>Números de WhatsApp</h1>
<p class="subtitulo">Conecte o WhatsApp da sua loja para começar a enviar mensagens automáticas.</p>

@if (!string.IsNullOrEmpty(Model.Erro))
{
    <div class="aviso aviso-erro">
        @Model.Erro
        @if (!string.IsNullOrEmpty(Model.PlanoSugerido))
        {
            <text> <a asp-page="/Planos">Ver o plano @Model.PlanoSugerido</a></text>
        }
    </div>
}

@if (!string.IsNullOrEmpty(Model.Sucesso))
{
    <div class="aviso aviso-ok">@Model.Sucesso</div>
}

@if (Model.PrimeiroAcesso)
{
    <div class="aviso aviso-ok">
        Conta criada. O primeiro passo é conectar um número de WhatsApp abaixo.
    </div>
}

@if (Model.ConectandoInstancia is not null)
{
    <div class="cartao">
        <h2>Conectar “@Model.ConectandoInstancia.Name”</h2>

        @if (Model.QrCodeBase64 is not null)
        {
            <div class="area-qr">
                <img src="data:image/png;base64,@Model.QrCodeBase64" alt="QR Code para conectar o WhatsApp" />
                <p class="dica" style="margin-top:14px">
                    No celular: <strong>WhatsApp → Configurações → Aparelhos conectados → Conectar aparelho</strong>
                </p>
                <p class="dica" id="aviso-expira">
                    O código expira em cerca de 1 minuto. Se expirar, recarregue a página.
                </p>
                <p id="estado-conexao" class="dica"><strong>Aguardando leitura…</strong></p>
            </div>
        }

        <div class="linha-acoes">
            <a class="botao botao-secundario" asp-page="/Instancias">Voltar</a>
            <a class="botao botao-secundario"
               asp-page="/Instancias"
               asp-route-conectar="@Model.ConectandoInstancia.Id">Gerar novo código</a>
        </div>
    </div>

    @section Scripts {
        <script>
            // Consulta o status de tempos em tempos para a tela avancar sozinha
            // assim que o lojista escanear o codigo.
            (function () {
                const id = '@Model.ConectandoInstancia.Id';
                const estado = document.getElementById('estado-conexao');
                let tentativas = 0;

                const timer = setInterval(async function () {
                    tentativas++;

                    try {
                        const r = await fetch('?handler=Status&id=' + id);
                        const dados = await r.json();
                        const s = (dados.status || '').toLowerCase();

                        if (s === 'open' || s === 'connected') {
                            clearInterval(timer);
                            estado.innerHTML = '<strong>Conectado. Redirecionando…</strong>';
                            setTimeout(() => window.location.href = '/Instancias', 1200);
                        }
                    } catch (e) {
                        // Falha de rede pontual nao deve parar o polling.
                    }

                    // ~2 minutos: depois disso o QR ja expirou de qualquer forma.
                    if (tentativas > 40) {
                        clearInterval(timer);
                        estado.innerHTML = '<strong>O código expirou.</strong> Clique em “Gerar novo código”.';
                    }
                }, 3000);
            })();
        </script>
    }
}
else
{
    <div class="cartao">
        <h2>Conectar um novo número</h2>
        <form method="post" asp-page-handler="Criar">
            <div class="campo">
                <label asp-for="Nome">Nome para identificar</label>
                <input asp-for="Nome" placeholder="Ex.: Atendimento da loja" />
                <p class="dica">Só para você organizar. O cliente não vê esse nome.</p>
            </div>
            <button type="submit" class="botao">Gerar QR Code</button>
        </form>
    </div>

    <div class="cartao">
        <h2>Seus números</h2>

        @if (!Model.Instancias.Any())
        {
            <div class="vazio">
                <p>Nenhum número conectado ainda.</p>
            </div>
        }
        else
        {
            <div class="rolagem">
                <table class="tabela">
                    <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Situação</th>
                        <th>Criado em</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var i in Model.Instancias)
                    {
                        <tr>
                            <td><strong>@i.Name</strong></td>
                            <td>
                                <span class="selo @AutoZapSaaS.Web.Pages.InstanciasModel.SeloDeStatus(i.Status)">
                                    @AutoZapSaaS.Web.Pages.InstanciasModel.TextoDeStatus(i.Status)
                                </span>
                            </td>
                            <td>@i.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td>
                                <div class="linha-acoes">
                                    <a class="botao botao-secundario botao-pequeno"
                                       asp-page="/Instancias" asp-route-conectar="@i.Id">
                                        @(i.Status.Equals("Connected", StringComparison.OrdinalIgnoreCase)
                                            ? "Reconectar" : "Conectar")
                                    </a>

                                    @if (i.Status.Equals("Connected", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <form method="post" asp-page-handler="Desconectar" asp-route-id="@i.Id">
                                            <button type="submit" class="botao botao-secundario botao-pequeno">
                                                Desconectar
                                            </button>
                                        </form>
                                    }

                                    <form method="post" asp-page-handler="Remover" asp-route-id="@i.Id"
                                          onsubmit="return confirm('Remover este número? As mensagens automáticas por ele param de funcionar.');">
                                        <button type="submit" class="botao botao-perigo botao-pequeno">Remover</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
