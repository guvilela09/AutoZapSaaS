# Copie para .env e preencha. O .env NAO vai para o git.
# Gere segredos fortes, nunca reutilize os exemplos abaixo.

# JWT — minimo 32 caracteres. Gerar com:
#   openssl rand -base64 48
JWT_SECRET=

# Senha do SQL Server e do Postgres (Evolution API)
SQL_SA_PASSWORD=
POSTGRES_PASSWORD=

# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=

# Evolution API — gerar com: openssl rand -hex 32
EVOLUTION_API_KEY=

# URL publica da API, usada para montar as URLs de webhook entregues aos tenants
PUBLIC_BASE_URL=http://localhost:5000

# Asaas — cobranca recorrente. Sandbox: https://api-sandbox.asaas.com/v3
# Sem ASAAS_API_KEY os planos pagos ficam indisponiveis (o Free continua funcionando).
ASAAS_API_KEY=
# Token que voce define no painel do Asaas e ele envia no header do webhook
ASAAS_WEBHOOK_TOKEN=
